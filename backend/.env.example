# KingIn Trading System - Environment Configuration Template
# ─────────────────────────────────────────────────────────
# INSTRUCTIONS: Copy this file to .env and fill in your values:
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows CMD)
#
# The .env file is git-ignored and will NEVER be committed.
# ─────────────────────────────────────────────────────────

# Dashboard login password (required — set this before running the app)
KINGIN_USER_PASSWORD=kingin123

# JWT signing secret — change to a long random string in production
KINGIN_JWT_SECRET=kingin-jwt-secret-change-in-production

# Internal API control token (must match X-Control-Token header in Electron)
# Do NOT change this unless you also update electron/main.js and kingin-vite/src/api.js
KINGIN_API_TOKEN=replit-local-control
