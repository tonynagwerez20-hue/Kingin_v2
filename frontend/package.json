{
  "name": "kingin-hardened",
  "version": "1.0.0",
  "description": "Institutional Trading System Native Desktop App",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:api": "cd ../backend && python kingin_api.py",
    "dev:vite": "vite --port 5173 --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build && node -e \"const fs=require('fs');const f='dist/index.html';fs.writeFileSync(f, fs.readFileSync(f,'utf8').replace(/ crossorigin/gi, ''))\"",
    "electron:build": "npm run build && electron-builder",
    "test": "cd ../backend && pytest Engine/tests"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  },
  "author": "KingIn Trading",
  "build": {
    "appId": "com.kingin.trading",
    "productName": "KingIn Trading System",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
